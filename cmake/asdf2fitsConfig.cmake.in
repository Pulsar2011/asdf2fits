@PACKAGE_INIT@

if(NOT TARGET asdf2fits::asdf2fits)
    add_library(asdf2fits::asdf2fits SHARED IMPORTED)
    set_target_properties(asdf2fits::asdf2fits PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/libasdf2fits${CMAKE_SHARED_LIBRARY_SUFFIX}"
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
    )
endif()

check_required_components(asdf2fits)
